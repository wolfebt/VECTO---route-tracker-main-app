{
  "name": "vecto-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "vitest run src/__tests__/firestoreRules.emulator.test.js",
    "test:rules:emulator": "firebase emulators:exec --only firestore \"npx vitest run src/__tests__/firestoreRules.emulator.test.js\"",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/status-bar": "^8.0.4",
    "@google/genai": "^3.6.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@vis.gl/react-google-maps": "^1.9.0",
    "firebase": "^12.16.0",
    "lucide-react": "^1.24.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "gh-pages": "^6.3.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "vitest": "^5.1.1"
  }
}
