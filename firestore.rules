rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCompanyMember(companyId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/companies/$(companyId)).data.createdBy == request.auth.uid
      );
    }

    function getMemberData(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data;
    }

    function isDispatcher(companyId) {
      return isCompanyMember(companyId) && (
        get(/databases/$(database)/documents/companies/$(companyId)).data.createdBy == request.auth.uid ||
        request.auth.token.email.toLowerCase() == 'btw.284@gmail.com' ||
        (
          exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)) && (
            getMemberData(companyId).permissions.canCreateJob == true ||
            getMemberData(companyId).permissions.canManageDrivers == true
          )
        )
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Companies Collection & Subcollections
    match /companies/{companyId} {
      // Authenticated users can read/list companies to view/join them
      allow read, create: if isAuthenticated();
      allow update, delete: if isDispatcher(companyId);

      // Members Subcollection
      match /members/{memberId} {
        allow read: if isCompanyMember(companyId);
        allow write: if isDispatcher(companyId) || isOwner(memberId);
      }

      // Jobs Subcollection
      match /jobs/{jobId} {
        allow read: if isCompanyMember(companyId);
        allow create, delete: if isDispatcher(companyId);
        allow update: if isCompanyMember(companyId);

        // Job Chat Subcollection
        match /chat/{chatId} {
          allow read, write: if isCompanyMember(companyId);
        }
      }

      // Active Drivers Subcollection
      match /active_drivers/{driverId} {
        // Dispatchers can read all active drivers.
        // Drivers can read their own location record or teammate location records.
        allow read: if isCompanyMember(companyId) && (
          isDispatcher(companyId) ||
          isOwner(driverId) ||
          (resource != null && resource.data.activeJobId != null)
        );

        // A driver can only update/create their own location document
        allow write: if isCompanyMember(companyId) && isOwner(driverId);
      }
    }
  }
}
