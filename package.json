{
  "name": "vecto-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run TEST_SUITE/formatters.test.js TEST_SUITE/stopsAndVehicles.test.js TEST_SUITE/dispatchAndMap.test.js TEST_SUITE/googleRoutesAndOffline.test.js TEST_SUITE/cryptoGeohashTrackingOcr.test.js TEST_SUITE/stores.test.js",
    "test:hooks": "vitest run TEST_SUITE/hooks",
    "test:ui": "vitest run TEST_SUITE/components",
    "test:fleet-assets": "vitest run TEST_SUITE/stopsAndVehicles.test.js TEST_SUITE/components/fleetAssetsAndDvir.test.jsx TEST_SUITE/components/fleetAnalyticsAndReports.test.jsx",
    "test:platform-assets": "vitest run TEST_SUITE/platformAssets.test.js",
    "test:functions": "vitest run TEST_SUITE/functions/cloudFunctions.test.js",
    "test:rules": "vitest run TEST_SUITE/securityRules.static.test.js TEST_SUITE/firestoreRules.emulator.test.js",
    "test:rules:emulator": "firebase emulators:exec --project demo-vecto --only firestore \"npx vitest run TEST_SUITE/firestoreRules.emulator.test.js\"",
    "test:all": "npm run lint && vitest run && npm run build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "npx -y firebase-tools@latest deploy --only hosting",
    "deploy:preview": "npm run build && npx -y firebase-tools@latest hosting:channel:deploy preview",
    "deploy:rules": "npx -y firebase-tools@latest deploy --only firestore:rules,firestore:indexes,storage",
    "deploy:firebase": "npm run build && npx -y firebase-tools@latest deploy --only hosting,firestore:rules,firestore:indexes,storage"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/status-bar": "^8.0.4",
    "@google/genai": "^3.6.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@vis.gl/react-google-maps": "^1.9.0",
    "firebase": "^12.16.0",
    "lucide-react": "^1.24.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^31.0.1",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "vitest": "^5.1.1"
  }
}
